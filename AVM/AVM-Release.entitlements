<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Release builds (2026-10-26). The same as AVM.entitlements without
  com.apple.security.cs.disable-library-validation: Tools/build-installer.sh
  signs every library and framework in the app with the one Developer ID,
  so library validation can stay on, and nothing signed by anyone else can
  be loaded into AVM (which the root USB helper trusts). Debug builds keep
  AVM.entitlements, because their sysroot libraries are signed ad hoc.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.hypervisor</key>
    <true/>
    <key>com.apple.security.virtualization</key>
    <true/>
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <key>com.apple.security.automation.apple-events</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.device.camera</key>
    <true/>
</dict>
</plist>
