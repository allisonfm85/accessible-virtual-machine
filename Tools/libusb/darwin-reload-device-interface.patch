+      } else {
+        priv->is_open = true;
+      }
+
+      /* create async event source */
+      kresult = (*dpriv->device)->CreateDeviceAsyncEventSource (dpriv->device,
+                                                                &priv->cfSource);
+      if (kresult != kIOReturnSuccess) {
+        usbi_err (HANDLE_CTX (dev_handle), "CreateDeviceAsyncEventSource: %s (0x%08x)", darwin_error_str(kresult), (unsigned) kresult);
 
