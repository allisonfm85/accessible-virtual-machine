+    /* AVM patch (Handoff 69): the cached device interface can go stale
+       while the IOService, its sessionID and its registry entry stay the
+       same. On macOS 27, when AccessoryAccess gives a device to an app,
+       accessoryaccessd takes exclusive ownership, and user clients made
+       before that stop working. A process that listed the device earlier
+       (a running QEMU) then can't open it. If opening fails, make a fresh
+       interface from the same service and try once more. */
+    for (int attempt = 0 ; ; attempt++) {
+      /* try to open the device */
+      kresult = (*dpriv->device)->USBDeviceOpenSeize (dpriv->device);
+      if (kresult != kIOReturnSuccess) {
+        usbi_warn (HANDLE_CTX (dev_handle), "USBDeviceOpen: %s (0x%08x)", darwin_error_str(kresult), (unsigned) kresult);
+
+        if (kIOReturnExclusiveAccess != kresult) {
+          if (0 == attempt && LIBUSB_SUCCESS == darwin_reload_device (dev_handle) && dpriv->device) {
+            usbi_warn (HANDLE_CTX (dev_handle), "reloaded the device interface; trying the open again");
+            continue;
+          }
+          return darwin_to_libusb (kresult);
+        }
 
-      if (kIOReturnExclusiveAccess != kresult) {
-        return darwin_to_libusb (kresult);
-      }
+        /* it is possible to perform some actions on a device that is not open so do not return an error */
