-      priv->is_open = false;
-    } else {
-      priv->is_open = true;
-    }
-
-    /* create async event source */
-    kresult = (*dpriv->device)->CreateDeviceAsyncEventSource (dpriv->device,
-                                                                                &priv->cfSource);
-    if (kresult != kIOReturnSuccess) {
-      usbi_err (HANDLE_CTX (dev_handle), "CreateDeviceAsyncEventSource: %s", darwin_error_str(kresult));
-
-      if (priv->is_open) {
-        (*dpriv->device)->USBDeviceClose (dpriv->device);
-      }
+        if (priv->is_open) {
+          (*dpriv->device)->USBDeviceClose (dpriv->device);
+        }
 
-      priv->is_open = false;
+        priv->is_open = false;
 
-      return darwin_to_libusb (kresult);
+        if (0 == attempt && LIBUSB_SUCCESS == darwin_reload_device (dev_handle) && dpriv->device) {
+          usbi_warn (HANDLE_CTX (dev_handle), "reloaded the device interface; trying the open again");
