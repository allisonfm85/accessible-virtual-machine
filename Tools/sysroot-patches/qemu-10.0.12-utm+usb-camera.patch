+                            required: false)
+  if avfoundation.found()
+    system_ss.add(when: 'CONFIG_USB', if_true: [files('dev-camera.m'), avfoundation])
+  endif
+endif
+
 # smartcard
 system_ss.add(when: 'CONFIG_USB_SMARTCARD', if_true: files('dev-smartcard-reader.c'))
 
--- /dev/null
+++ b/hw/usb/dev-camera.m
